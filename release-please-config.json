{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "go",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "include-v-in-tag": true,
  "changelog-path": "CHANGELOG.md",
  "packages": {
    ".": {
      "extra-files": [
        "README.md",
        "llms.txt",
        "docs/README.md",
        "docs/ai-guide.md",
        "docs/capabilities.md",
        "docs/migrations.md",
        "docs/supported-versions.md",
        "examples/README.md",
        "examples/adopt-existing-schema/README.md",
        "examples/custom-sql-migration/README.md",
        "examples/upgrade-database/README.md"
      ]
    },
    "otelmomo": {
      "component": "otelmomo",
      "include-component-in-tag": true,
      "tag-separator": "/",
      "release-type": "go"
    }
  }
}
